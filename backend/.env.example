# Application Environment & Logging
# Options: development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=auto

# AI Providers
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-7b

GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require

# CORS Configuration (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Authentication
# In development, the default fallback key is permitted for convenience.
# In production, JWT_SECRET_KEY is required, cannot be the default key, and must be >= 32 characters.
# Generate a secure 32-byte (64 hex characters) secret in PowerShell using Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_secure_random_hex_string_32_bytes_or_more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cloudinary Storage Configuration
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Rate Limiting & Abuse Protection (slowapi)
# Enable or disable rate limiting globally (default: True)
RATE_LIMITING_ENABLED=True

# Rate limiting storage backend (default: memory://)
# In production with multiple uvicorn workers or multi-instance deployments,
# use Redis storage to share counters across all workers and instances:
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URL=memory://

# Endpoint Rate Limits (format: "<count>/<minute|hour|day>")
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH_LOGIN=10/minute
RATE_LIMIT_AUTH_REGISTER=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_DOCUMENT_UPLOAD=20/minute
RATE_LIMIT_DOCUMENT_SEARCH=60/minute

# Reliability, Timeouts & Retry Policy
LLM_MAX_RETRIES=2
LLM_INITIAL_RETRY_DELAY=0.5
LLM_MAX_RETRY_DELAY=8.0
LLM_RETRY_JITTER=True
MISTRAL_TIMEOUT_SECONDS=30.0
GEMINI_TIMEOUT_SECONDS=30.0
CLOUDINARY_TIMEOUT_SECONDS=30.0
CLOUDINARY_MAX_RETRIES=2
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_READ_MAX_RETRIES=1

